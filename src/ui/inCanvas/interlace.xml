<!-- Interlace In-Canvas Element GUI. Mounted while exactly one interlace
  group or one baked weave is selected, withdrawn on deselect. The toggle
  flips the weave phase, the padding field widens live-group gaps, Ungroup
  releases the live members (same as Layers > Ungroup), and the crossing
  list flips one crossing's over side without touching the rest. -->
<inCanvas id="interlace" title="Interlace">
  <toggle key="alternate" label="Alternate weave" />
  <field key="padding" label="Gap padding" type="number" min="0" step="0.5" />
  <crossings key="crossings" label="Crossings" />
  <exportButton label="Ungroup" />
</inCanvas>
